{
  "name": "cinnamon-css",
  "version": "0.1.0",
  "description": "A CSS library emulating the Linux Mint Cinnamon desktop environment and Mint-Y design system for web applications.",
  "main": "dist/cinnamon.css",
  "style": "dist/cinnamon.css",
  "module": "src/index.css",
  "type": "module",
  "scripts": {
    "dev": "vite demo --port 5173",
    "build:css": "node scripts/bundle.js",
    "build:demo": "vite build demo --outDir dist/demo",
    "build": "npm run build:css && npm run build:demo",
    "preview": "vite preview demo --port 5173"
  },
  "keywords": [
    "css",
    "linux-mint",
    "cinnamon",
    "mint-y",
    "gtk",
    "design-system",
    "theme",
    "desktop-ui"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
